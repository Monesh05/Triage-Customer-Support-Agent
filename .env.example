# .env.example
# Purpose: Template of environment variables required to run CloudDesk. Copy to `.env`
#          (repo root, and/or clouddesk/backend/.env) and fill in real values. Never commit
#          the resulting `.env` file.
# Author: CloudDesk Team
# Date: 2026-09-21

# --- Database (Phase 1) ---
# Points at the `postgres` service in docker-compose.yml (host port 5433 -> container 5432).
DATABASE_URL=postgresql+asyncpg://clouddesk:clouddesk@localhost:5433/clouddesk

APP_ENV=development
LOG_LEVEL=INFO

# --- LLM gateway (Phase 3+) ---
# LLM_PROVIDER selects which set of credentials below is used: "openrouter" or "openai".
# Both are called through the same OpenAI-compatible client, so switching providers is
# a config-only change (see app/core/config.py / app/llm/client.py).
LLM_PROVIDER=openrouter

OPENROUTER_API_KEY=
OPENROUTER_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=

# --- Authentication (Phase 10, spec section 27) ---
# Signing secret for customer/staff login JWTs. MUST be a real random secret outside local
# development (see app/core/config.py's get_settings(), which refuses to start with the
# insecure default when APP_ENV != "development"). Generate one with, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-default-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Rate limiting (Phase 10, spec section 27) ---
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_CONVERSATIONS=10/minute

# --- CORS (Phase 9/10) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
