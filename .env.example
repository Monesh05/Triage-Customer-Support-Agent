# .env.example
# Purpose: Template of environment variables required to run CloudDesk. Copy to `.env`
#          (repo root, and/or clouddesk/backend/.env) and fill in real values. Never commit
#          the resulting `.env` file.
# Author: CloudDesk Team
# Date: 2026-09-21

# --- Database (Phase 1) ---
# Points at the `postgres` service in docker-compose.yml (host port 5433 -> container 5432).
DATABASE_URL=postgresql+asyncpg://clouddesk:clouddesk@localhost:5433/clouddesk

APP_ENV=development
LOG_LEVEL=INFO

# --- LLM gateway (placeholders for Phase 2+, not used by Phase 1) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
