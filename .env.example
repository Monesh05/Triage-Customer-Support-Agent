# .env.example
# Purpose: Template of environment variables required to run CloudDesk. Copy to `.env`
#          (repo root, and/or clouddesk/backend/.env) and fill in real values. Never commit
#          the resulting `.env` file.
# Author: CloudDesk Team
# Date: 2026-09-21

# --- Database (Phase 1) ---
# Points at the `postgres` service in docker-compose.yml (host port 5433 -> container 5432).
DATABASE_URL=postgresql+asyncpg://clouddesk:clouddesk@localhost:5433/clouddesk

APP_ENV=development
LOG_LEVEL=INFO

# --- LLM gateway (Phase 3+) ---
# LLM_PROVIDER selects which set of credentials below is used: "openrouter" or "openai".
# Both are called through the same OpenAI-compatible client, so switching providers is
# a config-only change (see app/core/config.py / app/llm/client.py).
LLM_PROVIDER=openrouter

OPENROUTER_API_KEY=
OPENROUTER_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=
